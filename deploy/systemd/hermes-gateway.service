[Unit]
Description=Hermes Agent Gateway
Documentation=https://github.com/NousResearch/hermes-agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/home/lighthouse/.hermes/hermes-agent
Environment=HOME=/home/lighthouse
Environment=HERMES_HOME=/home/lighthouse/.hermes
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/lighthouse/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run --replace
Restart=always
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/lighthouse/.hermes

[Install]
WantedBy=default.target
